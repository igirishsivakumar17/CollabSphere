# Ignore node_modules for both client and server
client/node_modules/
server/node_modules/

# Ignore build output
client/dist/
server/dist/

# Ignore environment files
client/.env
server/.env

# Ignore logs
client/logs/
server/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE-specific files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore coverage reports
client/coverage/
server/coverage/

# Ignore temporary files
*.tmp
*.temp